# macOS 本地文件
.DS_Store

# IntelliJ / Android Studio 生成的工程状态
*.iml
/.idea/

# Gradle / Kotlin 构建缓存
/.gradle/
/.kotlin/
**/build/

# Android 构建产物
.cxx/
.externalNativeBuild/
/app/release/
captures/
*.apk
*.aab
output-metadata.json
*.hprof

# 日志与本地凭据
*.log
*.jks
*.keystore
# Sta 的固定签名证书要进仓库：CI runner 每次都是新机器，
# 用自动生成的 debug 证书会导致每次签名不同，已装的包无法覆盖安装。
!keystore/sta-release.jks
keystore.properties
google-services.json

# 本地配置和临时分析产物
/local.properties
/.analysis/
/.tmp/

# 外部源码参考，仅供阅读，不参与当前仓库版本管理
/reference/
